# 复制本文件为 .env 后按需修改（Ollama 本地版可不填 DeepSeek Key）

# ----- 本地 Ollama（推荐分享给同学）-----
OLLAMA_MODEL=deepseek-r1:1.5b
OLLAMA_BASE_URL=http://127.0.0.1:11434
HOST=127.0.0.1
PORT=8002

# ----- 云端 DeepSeek（仅 python 910.py 需要）-----
# DEEPSEEK_API_KEY=sk-xxxx

# ----- Native RAG / 语义搜索（python -m semantic_search）-----
# 默认读取 Windows 用户环境变量 DEEPSEEK_API_KEY，不必写进 .env
# DEEPSEEK_API_KEY=sk-xxxx
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-v4-flash
# EMBEDDING_PROVIDER=huggingface
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# SEARCH_HOST=127.0.0.1
# SEARCH_PORT=8001
# RAG_DATA_DIR=semantic_search/data

# 复制本文件为 .env 后按需修改（Ollama 本地版可不填 DeepSeek Key）

# ----- 本地 Ollama（推荐分享给同学）-----
OLLAMA_MODEL=deepseek-r1:1.5b
OLLAMA_BASE_URL=http://127.0.0.1:11434
HOST=127.0.0.1
PORT=8002

# ----- 云端 DeepSeek（仅 python 910.py 需要）-----
# DEEPSEEK_API_KEY=sk-xxxx

# ----- Native RAG / 语义搜索（python -m semantic_search / chroma文档管理）-----
# 默认读取 Windows 用户环境变量 DEEPSEEK_API_KEY，不必写进 .env
# DEEPSEEK_API_KEY=sk-xxxx
# DASHSCOPE_API_KEY=sk-xxxx   # 重排 DashScopeRerank 需要；Embedding 用千问时也需要
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-v4-flash
# EMBEDDING_PROVIDER=chinese_clip          # 或 huggingface / dashscope
# EMBEDDING_MODEL=H:\二阶段\chinese-clip-vit-base-patch16
# CHROMA_COLLECTION=native_rag_chinese_clip   # 换 embedding 时建议换集合
# SEARCH_HOST=127.0.0.1
# SEARCH_PORT=8003
# RAG_DATA_DIR=semantic_search/data
#
# ----- 检索中 / 检索后优化开关（chroma文档管理）-----
# HYBRID_ENABLED=true              # 同库：向量 + BM25
# HYBRID_FUSION_MODE=reciprocal_rerank   # 或 relative_score
# RETRIEVE_CANDIDATES=20           # 粗排候选数
# RERANK_ENABLED=true
# RERANK_PROVIDER=local            # local=本地 bge（不需要千问）| dashscope | none
# RERANK_MODEL=BAAI/bge-reranker-base
# RERANK_TOP_N=0                   # 0=跟请求 k 一致
# COMPRESS_ENABLED=true            # 句子级压缩
# COMPRESS_PERCENTILE=0.5
# REORDER_ENABLED=true             # 长上下文首尾重排版
# CRAG_ENABLED=true                # Corrective RAG：过滤无关 + 全无关则改写重检索（不联网）
# CRAG_VERBOSE=true                # 终端打印每篇相关/无关
#
# ----- GraphRAG -----
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=你的Neo4j密码
# GRAPH_LLM_PROVIDER=deepseek      # deepseek | dashscope
# GRAPH_LLM_MODEL=deepseek-v4-flash
# GRAPH_EMBED_PROVIDER=chinese_clip  # chinese_clip | huggingface | dashscope（DeepSeek 无 embedding）
# GRAPH_EMBED_MODEL=H:\二阶段\chinese-clip-vit-base-patch16
# GRAPH_EXTRACTOR=simple           # simple | schema
# GRAPH_RAG_ENABLED=true
# DASHSCOPE_API_KEY=sk-xxxx        # 仅当 GRAPH_*_PROVIDER=dashscope 时需要
